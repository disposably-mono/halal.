{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2021",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"]
    },
    "noEmit": false,
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": ["**/*.ts"]
}
