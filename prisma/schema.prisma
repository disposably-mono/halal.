generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id         String          @id @default(cuid())
  electionId String
  action     String
  toStatus   ElectionStatus?
  adminEmail String
  createdAt  DateTime        @default(now())
  election   Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)
}

model Election {
  id                  String         @id @default(cuid())
  name                String
  division            Division
  status              ElectionStatus @default(DRAFT)
  scheduledOpen       DateTime?
  scheduledClose      DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  candidatesFinalized Boolean        @default(false)
  votersFinalized     Boolean        @default(false)
  archivedAt          DateTime?
  archivedBy          String?
  auditLogs           AuditLog[]
  positions           Position[]
  votes               Vote[]
  voters              Voter[]
  candidates  Candidate[]
}

model Position {
  id             String      @id @default(cuid())
  electionId     String
  title          String
  order          Int
  eligibleGrades Int[]       @default([])
  candidateGrade String      @default("")
  isActive       Boolean     @default(true)
  candidates     Candidate[]
  election       Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  votes          Vote[]
}

model Candidate {
  id         String   @id @default(cuid())
  positionId String
  fullName   String
  gradeLevel Int
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  votes      Vote[]
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

}

model Voter {
  id         String    @id @default(cuid())
  electionId String
  studentId  String
  gradeLevel Int
  division   Division
  voterCode  String    @unique
  hasVoted   Boolean   @default(false)
  votedAt    DateTime?
  createdAt  DateTime  @default(now())
  section    String
  election   Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, studentId])
}

model Vote {
  id          String     @id @default(cuid())
  electionId  String
  positionId  String
  isAbstain   Boolean    @default(false)
  candidateId String?
  castAt      DateTime   @default(now())
  // Cascade — deleting an election clears its votes (mirrors Position/Voter/Candidate cascade)
  election    Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  // Cascade — positions are election-scoped; if a position is removed, its votes go with it
  position    Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  // Restrict — never silently nullify or destroy cast votes; the candidates/actions.ts
  // removeCandidate guard checks vote count and short-circuits before this fires.
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Restrict)
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OFFICER)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  officerKey   String
}

model AdminLoginHistory {
  id            String   @id @default(cuid())
  officerId     String
  officerName   String
  officerEmail  String
  verifierId    String
  verifierName  String
  verifierEmail String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

enum Division {
  GS
  JHS
  SHS
  HC
}

enum ElectionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
}

enum AdminRole {
  SUPERADMIN
  COMMISSIONER
  CANVASSER
  OFFICER
}
