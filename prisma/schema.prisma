generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id         String          @id @default(cuid())
  electionId String
  action     String
  toStatus   ElectionStatus?
  adminEmail String
  createdAt  DateTime        @default(now())
  election   Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)

  // Control page loads scan by election, ordered by recency.
  @@index([electionId, createdAt])
}

model Election {
  id                  String         @id @default(cuid())
  name                String
  division            Division
  status              ElectionStatus @default(DRAFT)
  scheduledOpen       DateTime?
  scheduledClose      DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  candidatesFinalized Boolean        @default(false)
  votersFinalized     Boolean        @default(false)
  archivedAt          DateTime?
  archivedBy          String?
  auditKeyEncrypted   String?
  auditFingerprint    String?         @unique
  auditVersion        Int?
  auditLogs           AuditLog[]
  ballots             Ballot[]
  certification       ElectionCertification?
  recounts            Recount[]
  positions           Position[]
  votes               Vote[]
  voters              Voter[]
  candidates  Candidate[]
  monitorSnapshots    MonitorSnapshot[]
}

model Position {
  id             String      @id @default(cuid())
  electionId     String
  title          String
  order          Int
  eligibleGrades Int[]       @default([])
  candidateGrade String      @default("")
  isActive       Boolean     @default(true)
  candidates     Candidate[]
  election       Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  votes          Vote[]

  // Queried on every ballot cast and tally poll.
  @@index([electionId, isActive])
}

model Candidate {
  id         String   @id @default(cuid())
  positionId String
  fullName   String
  gradeLevel Int
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  votes      Vote[]
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@index([electionId])
}

model Voter {
  id         String    @id @default(cuid())
  electionId String
  studentId  String
  gradeLevel Int
  division   Division
  voterCode  String    @unique
  hasVoted   Boolean   @default(false)
  votedAt    DateTime?
  createdAt  DateTime  @default(now())
  section    String
  election   Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, studentId])
  // Cross-election manual-add and "other open election" lookups.
  @@index([gradeLevel, section])
  @@index([studentId])
}

model Vote {
  id          String     @id @default(cuid())
  electionId  String
  positionId  String
  isAbstain   Boolean    @default(false)
  candidateId String?
  castAt      DateTime   @default(now())
  ballotId    String?
  // Cascade — deleting an election clears its votes (mirrors Position/Voter/Candidate cascade)
  election    Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  // Cascade — positions are election-scoped; if a position is removed, its votes go with it
  position    Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  // Restrict — never silently nullify or destroy cast votes; the candidates/actions.ts
  // removeCandidate guard checks vote count and short-circuits before this fires.
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  ballot      Ballot?    @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  @@index([ballotId])
  // Results tally filters votes by electionId on every poll — index to avoid a seq scan.
  @@index([electionId])
  // Candidate-delete pre-check counts votes by candidateId — avoid a seq scan.
  @@index([candidateId])
}

model Ballot {
  id          String   @id @default(cuid())
  electionId  String
  receiptHash String   @unique
  nonce       String
  commitment  String
  version     Int       @default(1)
  castAt      DateTime  @default(now())
  verifiedAt  DateTime?
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  votes       Vote[]

  @@index([electionId])
}

model ElectionCertification {
  id           String   @id @default(cuid())
  electionId   String   @unique
  snapshot     Json
  snapshotHash String
  signature    String
  createdAt    DateTime @default(now())
  createdBy    String
  election     Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
}

model Recount {
  id             String   @id @default(cuid())
  electionId     String
  snapshot       Json
  snapshotHash   String
  signature      String
  baselineHash   String
  ballotCount    Int
  validBallots   Int
  invalidBallots Int
  matchesOfficial Boolean
  discrepancies  Json
  initiatedBy    String
  createdAt      DateTime @default(now())
  election       Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId, createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OFFICER)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  officerKey   String
}

// Persisted live-monitor tally snapshots. `bucket` is the 30s time-bucket
// (Math.floor(epochMs / POLL_INTERVAL)) that the payload was captured in; the
// unique constraint on (electionId, bucket) is what dedupes concurrent writes
// from multiple admin devices polling the same election at once. `payload` is
// exactly the anonymous aggregate JSON already returned by the results API
// (candidate vote counts, abstentions, turnout) — never voter-identifying data.
model MonitorSnapshot {
  id         String   @id @default(cuid())
  electionId String
  bucket     Int
  capturedAt DateTime @default(now())
  payload    Json
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, bucket])
  @@index([electionId, capturedAt])
}

model AdminLoginHistory {
  id            String   @id @default(cuid())
  officerId     String
  officerName   String
  officerEmail  String
  verifierId    String
  verifierName  String
  verifierEmail String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

enum Division {
  GS
  JHS
  SHS
  HC
}

enum ElectionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
}

enum AdminRole {
  SUPERADMIN
  COMMISSIONER
  CANVASSER
  OFFICER
}
