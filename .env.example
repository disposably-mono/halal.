# Database
DATABASE_URL="postgresql://halal:CHANGE_ME@localhost:5432/halal_db"
DB_USER="halal"
DB_PASSWORD="CHANGE_ME"
DB_NAME="halal_db"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3000"

# Encrypts per-election audit keys — generate once with: openssl rand -base64 32
# Back up this value. Losing it prevents receipt verification and recounts.
ELECTION_AUDIT_MASTER_KEY="CHANGE_ME"

# Seed credentials — used only by prisma/seed.ts
SEED_ADMIN_EMAIL="your-admin@email.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"
SEED_ADMIN_OFFICER_KEY="CHANGE_ME"
SEED_SECOND_ADMIN_EMAIL="verification-officer@email.com"
SEED_SECOND_ADMIN_PASSWORD="CHANGE_ME_TOO"
SEED_SECOND_ADMIN_OFFICER_KEY="CHANGE_ME_TOO"

# Cron protection — used by /api/cron/transition-elections
CRON_SECRET="CHANGE_ME"
